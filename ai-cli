#!/bin/bash

set -euo pipefail

DRY_RUN=false
MODEL_OVERRIDE=""
PLANNING_HTML=false

# Translate model names between providers
# Claude: opus, sonnet, haiku
# Copilot: gpt-4o, gpt-4o-mini, gpt-3.5-turbo, claude-sonnet-4, etc.
# Codex: gpt-5-codex, gpt-5, o3, etc. (OpenAI models; Claude names fall back to codex default)
translate_model() {
  local model="$1"
  local provider="$2"
  
  if [ -z "$model" ]; then
    echo ""
    return
  fi
  
  if [ "$provider" = "claude" ]; then
    # Already Claude model names, pass through
    echo "$model"
  elif [ "$provider" = "copilot" ]; then
    # For copilot, don't translate Claude model names - use copilot's default
    # Only pass through explicit copilot model names
    case "$model" in
      opus|sonnet|haiku)  echo "" ;;  # Use copilot default
      claude-*)
        echo "Warning: Full Claude model ID '$model' may not be supported by Copilot. Using Copilot default." >&2
        echo ""
        ;;
      *)  echo "$model" ;;  # Pass through explicit copilot models
    esac
  elif [ "$provider" = "cursor" ]; then
    # For cursor, don't translate Claude model shorthand - use cursor's default
    # Only pass through explicit cursor model names (e.g. gpt-5, sonnet-4-thinking)
    case "$model" in
      opus|sonnet|haiku)  echo "" ;;  # Use cursor default
      claude-*)
        echo "Warning: Full Claude model ID '$model' may not be supported by Cursor Agent. Using Cursor default." >&2
        echo ""
        ;;
      *)  echo "$model" ;;  # Pass through explicit cursor models
    esac
  elif [ "$provider" = "codex" ]; then
    # Codex uses OpenAI models (e.g. gpt-5-codex, gpt-5, o3), so Claude
    # shorthand/IDs have no equivalent — fall back to the codex default.
    case "$model" in
      opus|sonnet|haiku)  echo "" ;;  # Use codex default
      claude-*)
        echo "Warning: Claude model ID '$model' is not supported by Codex. Using Codex default." >&2
        echo ""
        ;;
      *)  echo "$model" ;;  # Pass through explicit codex models
    esac
  else
    echo "$model"
  fi
}

