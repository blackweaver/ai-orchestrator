$(find . -path "*/playwright/pages/*" -name "*.ts" -type f 2>/dev/null | sed 's#^\./##' | head -40 || echo "No page objects found")

### EXISTING PLAYWRIGHT TESTS (pattern reference)
$(find . -path "*/playwright/tests/*" -name "*.playwright.ts" -type f 2>/dev/null | sed 's#^\./##' | head -40 || echo "No existing tests found")

### EXTERNAL DOCUMENTATION (fetch these if your tooling supports it; otherwise apply their well-known conventions)
- Playwright Mocking System: https://favorengineering.atlassian.net/wiki/spaces/EN/pages/4148592781/Playwright+Mocking+System
- Playwright Pitfalls and How to Tackle these Issues: https://favorengineering.atlassian.net/wiki/spaces/EN/pages/4146823372/Playwright+Pitfalls+and+How+to+Tackle+these+Issues

EOF
}

run() {
  local instruction="$1"
  local dynamic_context="$2"
  local model="${3:-}"
  local dynamic_cmds="${4:-}"
  shift 4 || true

  local files
  files=$(existing_files "$@")

  if [ -z "$files" ]; then
    echo "Warning: No valid context files found for this command (skipped) — continuing without them."
  fi

  # Execute dynamic commands and capture output into context (live mode only)
  if [ -n "$dynamic_cmds" ] && [ "$DRY_RUN" = false ]; then
    local dynamic_cmd_output
    dynamic_cmd_output=$(eval "$dynamic_cmds" 2>&1 || true)
    if [ -n "$dynamic_cmd_output" ]; then
      dynamic_context="$dynamic_context

### COMMAND OUTPUT
\`\`\`
$dynamic_cmd_output
\`\`\`"
    fi
  fi

  # Get relative file paths for display
  local files_display
  files_display=$(echo "$files" | sed "s|$REPO_ROOT/||g" | tr '\n' ' ')

  # Split $files (newline-separated) into an array so a path containing a
  # space still works — a bare "cat $files" word-splits on whitespace and
  # silently drops/mismatches any such path, masked by the "|| true" below.
  local files_arr=()
  while IFS= read -r f; do
    [ -n "$f" ] && files_arr+=("$f")
  done <<< "$files"

  # Guard the zero-files case explicitly: "cat" with no arguments reads
  # stdin and blocks, it doesn't just produce empty output.
  local static_context=""
  if [ "${#files_arr[@]}" -gt 0 ]; then
    static_context="$(cat "${files_arr[@]}" 2>/dev/null || true)"
  fi

  local full_prompt="
  ### TASK
  $instruction

  ### STATIC CONTEXT
  $static_context

  ### DYNAMIC CONTEXT
  $dynamic_context

  ### USER REQUEST
  $PROMPT
  "

  # Prompt without static context (for dry-run display)
  local prompt_no_static="
  ### TASK
  $instruction

  ### DYNAMIC CONTEXT
  $dynamic_context

  ### USER REQUEST
  $PROMPT
  "

  run_ai "$full_prompt" "$model" "$files_display" "$prompt_no_static" "$dynamic_cmds"
}

case "$COMMAND" in
  chat)
    run_ai "$PROMPT"
    ;;

  audit)
    require_files "$BUG_HUNTING"
    DOCS_FILE=$(generate_docs_context smart)
    run "1) Review the current source-control changes (staged, unstaged, and against $BASE_BRANCH) against the criteria in $AI_PRIVATE_DIR/BUG-HUNTING.md and the project conventions included above. 2) Identify bugs, inefficiencies, and unclear code introduced by these changes. 3) Avoid modifying or refactoring code external to this branch's changes against $BASE_BRANCH. 5) Write a summary of findings and fixes applied to $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite), grouped by severity." \
      "$(refactor_context)" \
      "sonnet" \
      "" \
      "$BUG_HUNTING" "$DOCS_FILE"
    ;;

  debug)
    require_files "$DEBUG"
    DOCS_FILE=$(generate_docs_context smart)
    run "1) Root cause analysis, 2) Minimal reproduction steps, 3) Smallest safe fix with code changes, 4) Regression tests to prevent recurrence, 5) Write findings to $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite) with actionable suggestions grouped by severity. $(html_task_instruction) $PATH_NOTE. 6) Do NOT modify source files." \
      "$(debug_context)" \
      "opus" \
      "" \
      "$DEBUG" "$DOCS_FILE"
    ;;

  feature)
    require_files "$PLANNING"
    DOCS_FILE=$(generate_docs_context full)
    run "1) Implement the feature specified in $AI_PRIVATE_DIR/PLANNING.md. 2) Follow the project conventions included above under PROJECT CONVENTIONS. 3) Write clean, tested code matching existing patterns. 4) Create or update unit tests. $PATH_NOTE" \
      "$(feature_context)" \
      "" \
      "" \
      "$PLANNING" "$DOCS_FILE"
    ;;

  refactor)
    require_files "$REVIEW"
    DOCS_FILE=$(generate_docs_context smart)
    run "1) Apply the refactoring described in $AI_PRIVATE_DIR/REVIEW.md. 2) Preserve existing behavior while improving code quality. 3) Follow the project conventions included above under PROJECT CONVENTIONS. 4) Ensure all tests pass. 5) Create a refactoring summary inside $AI_PRIVATE_DIR/REFACTOR.md (if exists, overwrite). $PATH_NOTE" \
      "$(refactor_context)" \
      "" \
      "" \
      "$REVIEW" "$DOCS_FILE"
    ;;

  review)
    require_files "$REVIEW" "$LEARNED"
    DOCS_FILE=$(generate_docs_context smart)
    run "1) Review changed files against $BASE_BRANCH. 2) Check for: bugs, style violations, missing tests, performance issues, security concerns — per the project conventions included above under PROJECT CONVENTIONS. 3) Keep in mind $AI_PRIVATE_DIR/LEARNED.md (included above) about old reviews. 4) Write findings to $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite) with actionable suggestions grouped by severity. 5) $(html_task_instruction) $PATH_NOTE. 6) Do NOT modify source files." \
      "$(review_context)" \
      "" \
      "" \
      "$REVIEW" "$LEARNED" "$DOCS_FILE"
    ;;

  planning)
    require_files "$PLANNING"
    DOCS_FILE=$(generate_docs_context full)
    run "1) Create an implementation plan from the custom prompt, following the project conventions included above under PROJECT CONVENTIONS. 2) Do NOT modify source files. 3) Output: a) Architecture overview, b) Files to create/modify, c) Risks and mitigations, d) Implementation order, e) Test strategy. 4) Split the approach in small PRs with tested fatures, according our PR size convention. 5) Write the plan to $AI_PRIVATE_DIR/PLANNING.md. 5) $(html_task_instruction) $PATH_NOTE" \
      "$(planning_context)" \
      "opus" \
      "" \
      "$PLANNING" "$DOCS_FILE"
    ;;

  fix)
    require_files "$REVIEW"
    DOCS_FILE=$(generate_docs_context smart)
    run "1) Fix the bugs and improvements from $AI_PRIVATE_DIR/REVIEW.md. 2) Follow the project conventions included above under PROJECT CONVENTIONS. 3) Avoid modifying or refactoring code external to this branch changes against $BASE_BRANCH." \
      "$(review_context)" \
      "sonnet" \
      "" \
      "$REVIEW" "$DOCS_FILE"
    ;;

  suggestions)
    require_files "$BASE"
    pr_info=$(gh pr view --json number,url,title 2>/dev/null || echo "No open PR found")
    run "1) Use github mcp to get the fix suggestions comments from this branch PR. 2) Create a fix plan based on the suggestions. 3) Write into $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite). 4) Ensure all tests pass. $PATH_NOTE" \
      "$(review_context)

### CURRENT PR
$pr_info" \
      "sonnet" \
      "" \
      "$BASE"
    ;;

  commit)
    GIT_DOC="$REPO_ROOT/docs/workflow/git.md"
    require_files "$GIT_DOC"
    run "1) Generate a commit message for the staged changes, following the convention in docs/workflow/git.md included above: format \`[TICKET-ID] type: description\`, imperative mood, under 80 characters, types feat/fix/refactor/docs/test/chore, no Co-Authored-By trailer. 2) Extract the ticket ID from the branch name given in the context below. 3) Return ONLY the commit message, nothing else." \
      "$(cat <<EOF

### BRANCH
$(git branch --show-current 2>/dev/null || true)

### STAGED DIFF
$(git diff --cached 2>/dev/null || true)

EOF
)" \
      "sonnet" \
      "" \
      "$GIT_DOC"
    ;;

  pr)
    PR_DOC="$REPO_ROOT/.github/PULL_REQUEST_TEMPLATE.md"
    require_files "$PR_DOC"
    run "1) Generate a PR description for the changes in this branch against $BASE_BRANCH, following the structure of .github/PULL_REQUEST_TEMPLATE.md included above (Jira Link, What is changing?, How is this tested?, OWASP Top 10 Checklist). 2) Extract the ticket ID from the branch name (in the context below) for the Jira Link section. 3) Use markdown formatting." \
      "$(review_context)" \
      "sonnet" \
      "" \
      "$PR_DOC"
    ;;

  test)
    require_files "$BASE"
    run "1) Analyze the test output. 2) Focus on the root cause, not just making tests pass. 3) Suggest fixes. $PATH_NOTE" \
      "$(review_context)" \
      "sonnet" \
      "npm run test" \
      "$BASE"
    ;;

  types)
    DOCS_FILE=$(generate_docs_context smart)
    run "1) Fix TypeScript errors in the changed files. 2) Do not use 'any' - use \$TSFixMe with a comment if truly unavoidable. 3) Follow the project conventions included above under PROJECT CONVENTIONS." \
      "$(review_context)" \
      "sonnet" \
      "" \
      "$DOCS_FILE"
    ;;

  lint)
    DOCS_FILE=$(generate_docs_context smart)
    run "1) Analyze the lint output and fix ESLint and Prettier issues in the changed files. 2) Follow the project conventions included above under PROJECT CONVENTIONS." \
      "$(review_context)" \
      "sonnet" \
      "npm run check 2>&1 || true" \
      "$DOCS_FILE"
    ;;

  playwright-debug)
    DOCS_FILE=$(generate_docs_context smart)
    run "1) Analyze the Playwright E2E test output to identify failures introduced by this branch. 2) Compare changed files against $BASE_BRANCH to determine if failures are related to branch changes. 3) For each failure: identify root cause, affected component, and suggest a fix. 4) If mocks are stale or API responses changed, note which HAR files need updating. 5) Separately, review the CHANGED PLAYWRIGHT SPEC FILES for authoring patterns that risk corrupting the HAR on a future UPDATE_MOCKS recording, per the 'Stubs are disabled while recording' and 'Common leak stubs' sections of docs/testing/playwright.md included above — specifically: shouldUpdate computed inside the test body instead of hoisted to test.describe scope and passed via test.use (defeats the isRecording guard), route registration order that could shadow the intended mock (Playwright resolves LIFO), missing ignoreParams on routes with non-deterministic query params, and — if any CHANGED HAR MOCKS are listed above — stub-shaped bodies baked into them (e.g. '{\"total_matches\":0,\"results\":[]}', '{\"item_label_assignments\":{},\"labels\":[]}', '{\"feature_spotlights\":[]}') that should be a real recorded response instead. Report this as its own 'HAR Recording Risks' section, separate from runtime failures, even when nothing is currently failing. 6) Write findings to $AI_PRIVATE_DIR/REVIEW.md with actionable fixes grouped by severity. $PATH_NOTE" \
      "$(playwright_debug_context)" \
      "sonnet" \
      "npm run playwright 2>&1 || true" \
      "$DOCS_FILE"
    ;;

  playwright-test)
    require_files "$PLAYWRIGHT_RULES"
    DOCS_FILE=$(generate_docs_context smart)
    run "1) Write a new Playwright E2E test for the function/flow described in the USER REQUEST below. 2) Follow docs/testing/playwright.md included above under STATIC CONTEXT exactly: import test/expect from playwright/helpers/fixtures, hoist shouldUpdate to test.describe scope, use the mock fixture with HAR files under playwright/mocks/, pick the right storageState (basicUser/newUser) or leave unauthenticated as appropriate. 3) Before writing, consult the two external documentation links included under DYNAMIC CONTEXT (Playwright Mocking System, Playwright Pitfalls) for the team's current mocking conventions and known failure modes — fetch them if your tooling has web access. 4) Reuse an existing page object from playwright/pages/ (listed above) if the flow already has one; otherwise create a new page object following the same structure. 5) Save the new test under app/playwright/tests/<authenticated|unauthenticated>/<domain>/<Name>.playwright.ts. 6) Do not fabricate HAR fixture content — if a new HAR mock is required, note that it must be recorded via UPDATE_MOCKS against the shared automation@fv.rs QA account rather than hand-written. $PATH_NOTE" \
      "$(playwright_test_context)" \
      "sonnet" \
      "" \
      "$PLAYWRIGHT_RULES" "$DOCS_FILE"
    ;;

  explain)
    DOCS_FILE=$(generate_docs_context full)
    run "1) Explain the code, architecture, or pattern. 2) Be concise but thorough. 3) Include relevant file references." \
      "$(feature_context)" \
      "opus" \
      "" \
      "$DOCS_FILE"
    ;;

  *)
    usage
    exit 1
    ;;
esac