require_files() {
  for file in "$@"; do
    if [ ! -f "$file" ]; then
      echo "Warning: Missing file $file (skipped)"
    fi
  done
}

existing_files() {
  for file in "$@"; do
    [ -f "$file" ] && echo "$file"
  done
  return 0
}

# Reusable instruction for HTML task visualization
html_task_instruction() {
  if [ "$PLANNING_HTML" != "true" ]; then
    echo ""
    return
  fi
  local ts
  ts=$(date +%Y%m%d-%H%M%S)
  echo "Based on the above, create a clean, interactive, professional HTML/CSS/JS self-contained '${COMMAND}-${ts}.html' with modern styling (layout, colors, filters, charts). Save to $AI_PRIVATE_DIR/tasks/${COMMAND}-${ts}.html (create folder if needed)."
}

# Note about paths (used in prompts) - uses absolute path
PATH_NOTE="IMPORTANT: All output files must be written to $AI_PRIVATE_DIR/ (absolute path)."

# jq filter that turns cursor-agent's --output-format stream-json into readable live text.
# Only "assistant"/"thinking" events carrying timestamp_ms are true incremental deltas —
# cursor-agent re-emits a duplicate consolidated event (no timestamp_ms) after each one, which
# this filter skips to avoid printing every chunk twice.
cursor_stream_jq_filter() {
  cat <<'JQ'
if .type == "thinking" and .subtype == "delta" then .text
elif .type == "assistant" and (.timestamp_ms != null) then (.message.content[0].text // empty)
elif .type == "tool_call" and .subtype == "started" then
  "\n⚙ " + (((.tool_call | to_entries[0].value.args.description) // (.tool_call | to_entries[0].value.description) // "tool call")) + "\n"
elif .type == "result" then "\n"
else empty
end
JQ
}

run_ai() {
  local input="$1"
  local default_model="${2:-}"
  local files_display="${3:-}"
  local prompt_no_static="${4:-$input}"
  local dynamic_cmds="${5:-}"

  # Use override if set, otherwise use default
  local internal_model="${MODEL_OVERRIDE:-$default_model}"
  # Translate model for the provider
  local resolved_model
  resolved_model=$(translate_model "$internal_model" "$PROVIDER")

  echo "═══════════════════════════════════════════════════════════════"
  echo "Provider : $PROVIDER"
  echo "Command  : $COMMAND"
  echo "Branch   : $(git branch --show-current)"
  if [ -n "$internal_model" ]; then
    if [ "$internal_model" != "$resolved_model" ]; then
      echo "Model    : $internal_model → $resolved_model"
    else
      echo "Model    : $resolved_model"
    fi
  else
    echo "Model    : (default)"
  fi
  echo "Dry-run  : $DRY_RUN"
  echo "Planning : $PLANNING_HTML"
  echo "═══════════════════════════════════════════════════════════════"

  if [ "$DRY_RUN" = true ]; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║                    PROVIDER COMMAND                           ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    local cmd_prefix=""
    if [ -n "$files_display" ]; then
      cmd_prefix="cat $files_display"
    fi
    if [ -n "$dynamic_cmds" ]; then
      if [ -n "$cmd_prefix" ]; then
        cmd_prefix="{ $cmd_prefix; $dynamic_cmds; }"
      else
        cmd_prefix="{ $dynamic_cmds; }"
      fi
    fi
    
    case "$PROVIDER" in
      copilot)
        if [ -n "$cmd_prefix" ]; then
          if [ -n "$resolved_model" ]; then
            echo "$cmd_prefix | copilot --model $resolved_model --allow-all-tools --allow-all-paths --add-dir \$REPO_ROOT -p \"<PROMPT>\""
          else
            echo "$cmd_prefix | copilot --allow-all-tools --allow-all-paths --add-dir \$REPO_ROOT -p \"<PROMPT>\""
          fi
        else
          if [ -n "$resolved_model" ]; then
            echo "copilot --model $resolved_model --allow-all-tools --allow-all-paths --add-dir \$REPO_ROOT -p \"<PROMPT>\""
          else
            echo "copilot --allow-all-tools --allow-all-paths --add-dir \$REPO_ROOT -p \"<PROMPT>\""
          fi
        fi
        ;;
      claude)
        if [ -n "$cmd_prefix" ]; then
          if [ -n "$resolved_model" ]; then
            echo "$cmd_prefix | claude --dangerously-skip-permissions --model $resolved_model \"<PROMPT>\""
          else
            echo "$cmd_prefix | claude --dangerously-skip-permissions \"<PROMPT>\""
          fi
        else
          if [ -n "$resolved_model" ]; then
            echo "claude --dangerously-skip-permissions --model $resolved_model \"<PROMPT>\""
          else
            echo "claude --dangerously-skip-permissions \"<PROMPT>\""
          fi
        fi
        ;;
      cursor)
        if [ -n "$cmd_prefix" ]; then
          if [ -n "$resolved_model" ]; then
            echo "$cmd_prefix | cursor-agent --print --force --trust --output-format stream-json --stream-partial-output --model $resolved_model --add-dir \$REPO_ROOT \"<PROMPT>\" | jq -r -j '<stream formatter>'"
          else
            echo "$cmd_prefix | cursor-agent --print --force --trust --output-format stream-json --stream-partial-output --add-dir \$REPO_ROOT \"<PROMPT>\" | jq -r -j '<stream formatter>'"
          fi
        else
          if [ -n "$resolved_model" ]; then
            echo "cursor-agent --print --force --trust --output-format stream-json --stream-partial-output --model $resolved_model --add-dir \$REPO_ROOT \"<PROMPT>\" | jq -r -j '<stream formatter>'"
          else
            echo "cursor-agent --print --force --trust --output-format stream-json --stream-partial-output --add-dir \$REPO_ROOT \"<PROMPT>\" | jq -r -j '<stream formatter>'"
          fi
        fi
        ;;
      codex)
        local codex_flags="--dangerously-bypass-approvals-and-sandbox --add-dir \$REPO_ROOT"
        if [ -n "$resolved_model" ]; then
          codex_flags="--model $resolved_model $codex_flags"
        fi
        if [ -n "$cmd_prefix" ]; then
          echo "$cmd_prefix | codex $codex_flags \"<PROMPT>\""
        else
          echo "codex $codex_flags \"<PROMPT>\""
        fi
        ;;
    esac
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║                    <PROMPT> (without static context)          ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo "$prompt_no_static"
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "Prompt length: $(echo "$input" | wc -c | tr -d ' ') chars, $(echo "$input" | wc -l | tr -d ' ') lines"
    echo "═══════════════════════════════════════════════════════════════"
    return 0
  fi

  case "$PROVIDER" in
    copilot)
      if [ -n "$resolved_model" ]; then
        copilot --model "$resolved_model" --allow-all-tools --allow-all-paths --add-dir "$REPO_ROOT" -i "$input"
      else
        copilot --allow-all-tools --allow-all-paths --add-dir "$REPO_ROOT" -i "$input"
      fi
      ;;
    claude)
      if [ -n "$resolved_model" ]; then
        claude --dangerously-skip-permissions --model "$resolved_model" "$input"
      else
        claude --dangerously-skip-permissions "$input"
      fi
      ;;
    cursor)
      if [ -n "$resolved_model" ]; then
        cursor-agent --print --force --trust --output-format stream-json --stream-partial-output --model "$resolved_model" --add-dir "$REPO_ROOT" "$input" \
          | jq -r -j "$(cursor_stream_jq_filter)"
      else
        cursor-agent --print --force --trust --output-format stream-json --stream-partial-output --add-dir "$REPO_ROOT" "$input" \
          | jq -r -j "$(cursor_stream_jq_filter)"
      fi
      echo ""
      ;;
    codex)
      if [ -n "$resolved_model" ]; then
        codex --model "$resolved_model" --dangerously-bypass-approvals-and-sandbox --add-dir "$REPO_ROOT" "$input"
      else
        codex --dangerously-bypass-approvals-and-sandbox --add-dir "$REPO_ROOT" "$input"
      fi
      ;;
    *)
      echo "Error: Unknown provider '$PROVIDER'"
      usage
      exit 1
      ;;
  esac
}

base_repo_context() {
  cat <<EOF

### BRANCH
$(git branch --show-current 2>/dev/null || true)

### REPO STATUS
$(git status --short 2>/dev/null || true)

### RECENT COMMITS
$(git log --oneline -8 2>/dev/null || true)

EOF
}

changed_files_context() {
  cat <<EOF

### CHANGED FILES AGAINST MASTER
$(git diff --name-only ${BASE_BRANCH}...HEAD 2>/dev/null || true)

EOF
}

# --- Project conventions context (docs/, .claude/rules/) -------------------
#
# CLAUDE.md and .claude/rules/*.md use bare "@relative/path" lines as Claude
# Code's own transclusion syntax. Only the `claude` provider's own process
# resolves those automatically when it re-reads CLAUDE.md from $REPO_ROOT;
# copilot/cursor just see the literal "@docs/..." text. These functions
# resolve the imports in bash so every provider gets the real doc content.

# Absolute-ish path used as a dedupe key so the same doc is never printed
# twice in one generate_docs_context call (e.g. reached once via CLAUDE.md's
# own @-list and again via a .claude/rules/*.md that points at the same file).
_canon_path() {
  local f="$1"
  echo "$(cd "$(dirname "$f")" 2>/dev/null && pwd -P)/$(basename "$f")"
}

_already_resolved() {
  case $'\n'"$_RESOLVED_PATHS"$'\n' in
    *$'\n'"$1"$'\n'*) return 0 ;;
    *) return 1 ;;
  esac
}

# Recursively expands "@relative/path" lines into the referenced file's
# content. Non-"@" lines pass through unchanged. Skips a file already
# resolved earlier in the same generate_docs_context call (see _RESOLVED_PATHS).
resolve_at_imports() {
  local file="$1"
  [ -f "$file" ] || return 0

  local abs
  abs=$(_canon_path "$file")
  _already_resolved "$abs" && return 0
  _RESOLVED_PATHS="$_RESOLVED_PATHS
$abs"

  local base_dir
  base_dir=$(dirname "$file")

  local line
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^@(.+)$ ]]; then
      local ref="${BASH_REMATCH[1]}"
      local ref_path="$base_dir/$ref"
      # Tolerate a stale "@dir/file.md" reference left over from moving a doc
      # into "dir/file/" (e.g. CLAUDE.md's "@docs/testing/jest.md" — the real
      # file is docs/testing/jest/index.md now, in a dir named without ".md").
      if [ ! -f "$ref_path" ] && [ -f "${ref_path%.md}/index.md" ]; then
        ref_path="${ref_path%.md}/index.md"
      fi
      if [ -f "$ref_path" ]; then
        resolve_at_imports "$ref_path"
        echo ""
      else
        echo "$line"
      fi
    else
      echo "$line"
    fi
  done < "$file"
}

# Full expansion of CLAUDE.md -> AGENTS.md + every docs/*.md it references,
# PLUS every doc referenced by a .claude/rules/*.md rule (react-query.md,
# css-modules.md, the style variant of feature-flags.md, jest topic guides —
# these are normally path-triggered, not part of CLAUDE.md's own @-list, but
# there's no diff to trigger them off here). For commands with no reliable
# branch diff to scope against (feature: new work not yet reflected in a
# diff; explain/planning: may need any part of the repo).
full_docs_context() {
  resolve_at_imports "$BASE"

  local rules_dir="$REPO_ROOT/.claude/rules"
  [ -d "$rules_dir" ] || return 0

  local rule_file
  for rule_file in "$rules_dir"/*.md; do
    [ -f "$rule_file" ] || continue

    local ref
    ref=$(grep -m1 -E '^@' "$rule_file" 2>/dev/null || true)
    [ -n "$ref" ] || continue

    local ref_path="$rules_dir/${ref#@}"
    [ -f "$ref_path" ] || continue

    local abs
    abs=$(_canon_path "$ref_path")
    _already_resolved "$abs" && continue

    echo "### $(basename "$ref_path")"
    resolve_at_imports "$ref_path"
    echo ""
  done
}

# Cross-references files touched on this branch against each rule's `paths:`
# glob list in .claude/rules/*.md, and includes only the docs whose rule
# matched — mirrors Claude Code's own path-triggered rule loading, made
# explicit so copilot/cursor get the same targeted guidance without paying
# for the full docs/ corpus on every call.
smart_docs_context() {
  echo "### AGENTS.md"
  cat "$REPO_ROOT/AGENTS.md" 2>/dev/null || true
  echo ""

  local rules_dir="$REPO_ROOT/.claude/rules"
  [ -d "$rules_dir" ] || return 0

  local changed_files
  changed_files="$(git diff --name-only ${BASE_BRANCH}...HEAD 2>/dev/null || true)
$(git diff --name-only 2>/dev/null || true)
$(git diff --cached --name-only 2>/dev/null || true)"

  [ -n "${changed_files//[$'\n' ]/}" ] || return 0

  # NOTE: no `globstar` — macOS ships bash 3.2 (no globstar support), and it's
  # not needed anyway: `[[ str == pattern ]]` isn't pathname expansion, so a
  # bare `*` already matches "/" without it.
  shopt -s extglob nullglob

  local rule_file
  for rule_file in "$rules_dir"/*.md; do
    [ -f "$rule_file" ] || continue

    local globs
    globs=$(sed -n '/^paths:/,/^---/p' "$rule_file" 2>/dev/null \
      | grep -E '^[[:space:]]*-[[:space:]]' \
      | sed -E "s/^[[:space:]]*-[[:space:]]*['\"]?//; s/['\"]?[[:space:]]*\$//" || true)

    local matched=false
    local glob f
    while IFS= read -r glob; do
      [ -n "$glob" ] || continue
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        # shellcheck disable=SC2053 -- intentional: $glob must stay unquoted
        # so it's matched as a pattern, not compared as a literal string.
        if [[ "$f" == $glob ]]; then
          matched=true
          break
        fi
      done <<< "$changed_files"
      [ "$matched" = true ] && break
    done <<< "$globs"

    if [ "$matched" = true ]; then
      local ref
      ref=$(grep -m1 -E '^@' "$rule_file" 2>/dev/null || true)
      if [ -n "$ref" ]; then
        local ref_path="$rules_dir/${ref#@}"
        if [ -f "$ref_path" ]; then
          echo "### $(basename "$ref_path")"
          resolve_at_imports "$ref_path"
          echo ""
        fi
      fi
    fi
  done
}

# Writes the resolved conventions (mode: "full" or "smart") to a generated
# file under .ai-private/ and echoes its path, so it flows through the
# existing file-based static-context mechanism in run(). PID-suffixed so two
# concurrent ai-cli invocations can't clobber each other's file mid-read;
# the ".generated-docs-context.md" mirror alongside it is just a fixed-name
# copy for manual inspection (e.g. opening it in an editor) and isn't read
# by run() itself.
generate_docs_context() {
  local mode="$1"
  local out_file="$AI_PRIVATE_DIR/.generated-docs-context.$$.md"
  _RESOLVED_PATHS=""

  {
    echo "### PROJECT CONVENTIONS (auto-generated, do not edit)"
    echo ""
    if [ "$mode" = "full" ]; then
      full_docs_context
    else
      smart_docs_context
    fi
  } > "$out_file"

  cp "$out_file" "$AI_PRIVATE_DIR/.generated-docs-context.md" 2>/dev/null || true

  echo "$out_file"
}

