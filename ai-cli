  PROMPT="General $COMMAND request"
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)

if [ -z "$REPO_ROOT" ]; then
  echo "Error: Not inside a git repository"
  exit 1
fi

cd "$REPO_ROOT"

# Base branch for diffs: prefer master, fall back to main when master doesn't exist
BASE_BRANCH="master"
for candidate in master origin/master main origin/main; do
  if git rev-parse --verify --quiet "$candidate" >/dev/null; then
    BASE_BRANCH="$candidate"
    break
  fi
done

# Ensure .ai-private directory exists with proper permissions
AI_PRIVATE_DIR="$REPO_ROOT/.ai-private"
if [ ! -d "$AI_PRIVATE_DIR" ]; then
  mkdir -p "$AI_PRIVATE_DIR"
  chmod 755 "$AI_PRIVATE_DIR"
fi

BASE="$REPO_ROOT/CLAUDE.md"
