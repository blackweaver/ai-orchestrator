if [ "$#" -eq 0 ]; then
  usage
  exit 1
fi

# Parse global flags (--dry-run, --model, --planning) — accepted before provider
while true; do
  case "${1:-}" in
    --dry-run|-d)
      DRY_RUN=true
      shift
      ;;
    --model|-m)
      shift
      MODEL_OVERRIDE="${1:-}"
      shift || true
      ;;
    --planning|-p)
      PLANNING_HTML=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

PROVIDER="${1:-}"
shift || true

# Also accept flags after provider for backward compatibility
while true; do
  case "${1:-}" in
    --dry-run|-d)
      DRY_RUN=true
      shift
      ;;
    --model|-m)
      shift
      MODEL_OVERRIDE="${1:-}"
      shift || true
      ;;
    --planning|-p)
      PLANNING_HTML=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

COMMAND="${1:-}"
shift || true

PROMPT="$*"

KNOWN_COMMANDS=("audit" "commit" "debug" "explain" "feature" "fix" "lint" "playwright-debug" "playwright-test" "pr" "refactor" "review" "planning" "suggestions" "test" "types")

